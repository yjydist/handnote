{
  "name": "handnote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "handnote": "./src/cli.ts"
  },
  "scripts": {
    "check": "biome check .",
    "eval:real": "bun run scripts/real-eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval:ink:prepare": "bun experiments/ink/prepare.ts",
    "eval:ink": "bun experiments/ink/render.ts",
    "eval:ink:auto": "bun experiments/ink/automatic.ts"
  },
  "dependencies": {
    "commander": "15.0.0",
    "playwright": "1.62.0",
    "sharp": "0.35.0",
    "yaml": "2.8.1",
    "zod": "4.1.12",
    "@handnote/renderer": "workspace:*",
    "@handnote/ink": "workspace:*",
    "@handnote/agent": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "1.2.21",
    "@types/hast": "3.0.5",
    "typescript": "5.9.2",
    "ai": "7.0.77",
    "@ai-sdk/provider": "4.0.7"
  },
  "engines": {
    "bun": ">=1.4.0 <1.5.0"
  },
  "workspaces": [
    "packages/renderer",
    "packages/ink",
    "packages/agent"
  ]
}
