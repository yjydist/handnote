{
  "name": "handnote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "handnote": "./src/cli.ts"
  },
  "scripts": {
    "check": "biome check .",
    "eval:real": "bun run scripts/real-eval.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval:ink:full": "bun scripts/ink-eval.ts"
  },
  "dependencies": {
    "playwright": "1.62.0",
    "sharp": "0.35.0",
    "zod": "4.1.12",
    "@handnote/renderer": "workspace:*",
    "@handnote/ink": "workspace:*",
    "@handnote/app": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/bun": "1.2.21",
    "@types/hast": "3.0.5",
    "typescript": "5.9.2"
  },
  "engines": {
    "bun": ">=1.4.0 <1.5.0"
  },
  "workspaces": [
    "apps/handnote",
    "packages/renderer",
    "packages/ink",
    "packages/agent"
  ]
}
